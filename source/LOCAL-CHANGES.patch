+uint16_t AssignUdpSessionPort_(const std::set<uint16_t> &takenPorts)
+{
+	const uint16_t reserved = XllnReserveUdpSessionPort_();
+	// The reservation is what the title cached at boot, so the first UDP port-0 claim takes it.
+	// A later claim (or a taken reservation) falls back to a random port that no socket holds.
+	if (!xlln_title_session_port_claimed && !takenPorts.count(reserved)) {
+		xlln_title_session_port_claimed = true;
+		return reserved;
+	}
+	const uint16_t base = 0xC000;
+	const uint16_t range = 0xFFFF - base;
+	uint16_t port;
+	do {
+		port = base + (rand() % range);
+	} while (takenPorts.count(port));
+	return port;
+}
