+
+// The UDP session port this instance reserves at boot (first XNetGetTitleXnAddr) and assigns to
+// the first UDP socket that requests port 0. Zero until reserved.
+static uint16_t xlln_title_session_port_reserved = 0;
+static bool xlln_title_session_port_claimed = false;
+
+uint16_t XllnReserveUdpSessionPort_()
+{
+	if (!xlln_title_session_port_reserved) {
+		const uint16_t base = 0xC000;
+		const uint16_t range = 0xFFFF - base;
+		xlln_title_session_port_reserved = base + (uint16_t)(xlln_global_instance_id % range);
+	}
+	return xlln_title_session_port_reserved;
